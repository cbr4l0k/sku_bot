BOT_TOKEN=123456:replace-me
DOMAIN=club.example.com
ADMIN_IDS=123456789
# DEPRECATED. The chat catalog lives in the database now: the bot files a chat the
# moment it is added to one, and a general admin picks its city under Admin → Chats.
# Anything still listed here is filed under Saint Petersburg at boot; once that has
# happened, delete this line.
EVENT_GROUPS=
WEBHOOK_SECRET=replace-with-random-string
CHECKIN_SECRET=replace-with-random-string
# Leave both empty until the club's YooKassa shop is ready. Paid checkout stays
# visibly unavailable, while ticket setup and the rest of the bot keep working.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# High-entropy token included in the webhook URL query string.
YOOKASSA_WEBHOOK_SECRET=
# Optional: enables YooKassa receipt payloads (1-10, as assigned by your
# accountant/YooKassa setup). Checkout then requires the user's saved phone.
YOOKASSA_VAT_CODE=
DATABASE_PATH=./data/sku.db
NODE_ENV=development
