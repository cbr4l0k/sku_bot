{
  "name": "sku-bot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --cwd packages/cities typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/server typecheck && bun run --cwd apps/miniapp typecheck",
    "test": "bun test",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "event:people": "bun run scripts/event-people.ts",
    "event:add-person": "bun run scripts/add-event-person.ts",
    "event:remove-person": "bun run scripts/remove-event-person.ts",
    "event:reset": "bun run scripts/reset-event.ts",
    "event:export": "bun run scripts/export-event.ts",
    "series:backfill": "bun run scripts/backfill-series.ts",
    "refund:reconcile": "bun run scripts/reconcile-yookassa-refund.ts"
  }
}
